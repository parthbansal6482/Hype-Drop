{% style %}
  .drop-grid-section--{{ section.id }} {
    padding: {{ section.settings.padding_y }}px 0;
    background-color: var(--color-background);
  }

  .drop-grid-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .drop-grid-heading {
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .drop-grid-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px; /* Creates the strict grid lines */
    background-color: var(--color-foreground); /* The grid line color */
    border: 1px solid var(--color-foreground);
  }

  .drop-grid-item {
    background-color: var(--color-background);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* Make every 3rd item span full width for asymmetry */
  .drop-grid-item:nth-child(3n) {
    grid-column: 1 / -1;
  }
  
  .drop-grid-item:nth-child(3n) .drop-item-image-wrapper {
    aspect-ratio: 21 / 9;
  }

  .drop-item-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .drop-item-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--transition-curve);
  }

  .drop-grid-item:hover .drop-item-image-wrapper img {
    transform: scale(1.08);
  }

  .drop-item-details {
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-top: 1px solid var(--color-foreground);
    background: var(--color-background);
    z-index: 2;
  }

  .drop-item-title {
    font-size: 1.2rem;
    font-weight: bold;
    text-transform: uppercase;
    margin: 0 0 0.5rem 0;
  }

  .drop-item-price {
    font-size: 1.1rem;
    color: var(--color-accent-neon);
    font-weight: 600;
  }

  @media screen and (max-width: 768px) {
    .drop-grid-container {
      grid-template-columns: 1fr;
    }
    .drop-grid-item:nth-child(3n) {
      grid-column: 1;
    }
    .drop-grid-item:nth-child(3n) .drop-item-image-wrapper {
      aspect-ratio: 4 / 5;
    }
  }
{% endstyle %}

<div class="drop-grid-section--{{ section.id }} full-width">
  <div class="drop-grid-header">
    {% if section.settings.heading != blank %}
      <h2 class="drop-grid-heading">{{ section.settings.heading }}</h2>
    {% endif %}
  </div>

  <div class="drop-grid-container">
    {%- assign collection = collections[section.settings.collection] -%}
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: section.settings.products_to_show %}
        <a href="{{ product.url }}" class="drop-grid-item">
          <div class="drop-item-image-wrapper">
            {% if product.featured_image != blank %}
              <img src="{{ product.featured_image | image_url: width: 1200 }}" 
                   alt="{{ product.featured_image.alt | escape }}" 
                   loading="lazy">
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          <div class="drop-item-details">
            <div class="drop-item-meta">
              <h3 class="drop-item-title">{{ product.title }}</h3>
            </div>
            <div class="drop-item-price">
              {{ product.price | money }}
            </div>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..section.settings.products_to_show) %}
        <div class="drop-grid-item">
          <div class="drop-item-image-wrapper">
            {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
          <div class="drop-item-details">
            <div class="drop-item-meta">
              <h3 class="drop-item-title">Example Drop Piece</h3>
            </div>
            <div class="drop-item-price">
              $199.00
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Lookbook Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LATEST DROPS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 3,
      "unit": "prd",
      "label": "Products to show",
      "default": 6
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Lookbook Grid",
      "category": "Collection"
    }
  ]
}
{% endschema %}
