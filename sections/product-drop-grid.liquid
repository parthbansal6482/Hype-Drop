{% style %}
  .drop-grid-section--{{ section.id }} {
    padding: {{ section.settings.padding_y }}px 0;
    background-color: var(--color-background);
  }

  .drop-grid-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .drop-grid-heading {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .drop-grid-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4rem 2rem;
    padding: 0 2rem;
  }

  .drop-grid-item {
    background-color: var(--color-background);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* Make every 3rd item span full width for asymmetry */
  .drop-grid-item:nth-child(3n) {
    grid-column: 1 / -1;
  }
  
  .drop-grid-item:nth-child(3n) .drop-item-image-wrapper {
    aspect-ratio: 21 / 9;
  }

  .drop-item-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .drop-item-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--transition-duration) var(--transition-curve);
  }

  .drop-grid-item:hover .drop-item-image-wrapper img {
    opacity: 0.85;
  }

  .drop-item-details {
    padding: 1.5rem 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    background: var(--color-background);
    z-index: 2;
  }

  .drop-item-title {
    font-size: 1rem;
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 0.5rem 0;
  }

  .drop-item-price {
    font-size: 1rem;
    color: var(--color-foreground);
    font-weight: normal;
  }

  @media screen and (max-width: 768px) {
    .drop-grid-container {
      grid-template-columns: 1fr;
    }
    .drop-grid-item:nth-child(3n) {
      grid-column: 1;
    }
    .drop-grid-item:nth-child(3n) .drop-item-image-wrapper {
      aspect-ratio: 4 / 5;
    }
  }
{% endstyle %}

<div class="drop-grid-section--{{ section.id }} full-width">
  <div class="drop-grid-header">
    {% if section.settings.heading != blank %}
      <h2 class="drop-grid-heading">{{ section.settings.heading }}</h2>
    {% endif %}
  </div>

  <div class="drop-grid-container">
    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% assign product = all_products[block.settings.product] %}
        {% if product != blank %}
          <a href="{{ product.url }}" class="drop-grid-item" {{ block.shopify_attributes }}>
            <div class="drop-item-image-wrapper">
              {% if product.featured_image != blank %}
                <img src="{{ product.featured_image | image_url: width: 1200 }}" 
                     alt="{{ product.featured_image.alt | escape }}" 
                     loading="lazy" width="1200" height="1500">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            <div class="drop-item-details">
              <div class="drop-item-meta">
                <h3 class="drop-item-title">{{ product.title }}</h3>
              </div>
              <div class="drop-item-price">
                {{ product.price | money }}
              </div>
            </div>
          </a>
        {% else %}
          <div class="drop-grid-item" {{ block.shopify_attributes }}>
            <div class="drop-item-image-wrapper">
              {{ 'product-' | append: forloop.index | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="drop-item-details">
              <div class="drop-item-meta">
                <h3 class="drop-item-title">Example Drop Piece</h3>
              </div>
              <div class="drop-item-price">
                $199.00
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% else %}
      {%- assign collection = collections[section.settings.collection] -%}
      {% if collection != blank and collection.products_count > 0 %}
        {% for product in collection.products limit: section.settings.products_to_show %}
          <a href="{{ product.url }}" class="drop-grid-item">
            <div class="drop-item-image-wrapper">
              {% if product.featured_image != blank %}
                <img src="{{ product.featured_image | image_url: width: 1200 }}" 
                     alt="{{ product.featured_image.alt | escape }}" 
                     loading="lazy" width="1200" height="1500">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            <div class="drop-item-details">
              <div class="drop-item-meta">
                <h3 class="drop-item-title">{{ product.title }}</h3>
              </div>
              <div class="drop-item-price">
                {{ product.price | money }}
              </div>
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.products_to_show) %}
          <div class="drop-grid-item">
            <div class="drop-item-image-wrapper">
              {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="drop-item-details">
              <div class="drop-item-meta">
                <h3 class="drop-item-title">Example Drop Piece</h3>
              </div>
              <div class="drop-item-price">
                $199.00
              </div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Lookbook Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LATEST DROPS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 3,
      "unit": "prd",
      "label": "Products to show",
      "default": 6
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook Grid",
      "category": "Collection"
    }
  ]
}
{% endschema %}
