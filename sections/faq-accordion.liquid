{% style %}
  .faq-section {
    padding: 2rem 0 6rem;
    background-color: #FFFFFF;
  }

  .faq-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .faq-accordion {
    border-top: 1px solid #000000;
  }

  .faq-item {
    border-bottom: 1px solid #000000;
  }

  .faq-title {
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    padding: 2rem 0;
    font-weight: 900;
    text-transform: uppercase;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .faq-title::after {
    content: '+';
    font-size: 2rem;
    font-weight: 300;
    line-height: 1;
  }

  .faq-item.is-open .faq-title::after {
    content: '−';
  }

  .faq-content {
    display: none;
    padding-bottom: 2rem;
    font-size: 1rem;
    line-height: 1.6;
    font-weight: 400;
    max-width: 65ch;
  }

  .faq-item.is-open .faq-content {
    display: block;
  }
{% endstyle %}

<div class="faq-section full-width">
  <div class="faq-container">
    <div class="faq-accordion" id="FaqAccordion">
      {% for block in section.blocks %}
        <div class="faq-item" {{ block.shopify_attributes }}>
          <button type="button" class="faq-title">{{ block.settings.question }}</button>
          <div class="faq-content">
            {{ block.settings.answer }}
          </div>
        </div>
      {% endfor %}
      
      {% if section.blocks.size == 0 %}
        <div class="faq-item">
          <button type="button" class="faq-title">HOW LONG DOES SHIPPING TAKE?</button>
          <div class="faq-content">All orders are processed within 1-2 business days. Domestic shipping takes 3-5 days. International takes 7-14 days.</div>
        </div>
        <div class="faq-item">
          <button type="button" class="faq-title">WHAT IS YOUR RETURN POLICY?</button>
          <div class="faq-content">Returns are accepted within 14 days of delivery. Items must be unworn with original tags attached.</div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const faqContainer = document.getElementById('FaqAccordion');
    if (faqContainer) {
      const faqTitles = faqContainer.querySelectorAll('.faq-title');
      faqTitles.forEach(title => {
        title.addEventListener('click', function() {
          const item = this.parentElement;
          const isOpen = item.classList.contains('is-open');
          
          // Close all others
          faqContainer.querySelectorAll('.faq-item').forEach(i => i.classList.remove('is-open'));
          
          // Toggle current
          if (!isOpen) {
            item.classList.add('is-open');
          }
        });
      });
    }
  });
</script>

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "QUESTION HERE?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Your answer here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
