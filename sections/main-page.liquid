{% style %}
  .page-section {
    padding: 6rem 0;
    background-color: #FFFFFF;
  }

  .page-container {
    max-width: 65ch;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .page-header {
    margin-bottom: 4rem;
    text-align: left;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .page-content {
    font-size: 1rem;
    line-height: 1.6;
    font-weight: 400;
  }

  /* Basic typography formatting inside page content */
  .page-content h1,
  .page-content h2,
  .page-content h3,
  .page-content h4,
  .page-content h5,
  .page-content h6 {
    font-weight: 900;
    text-transform: uppercase;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .page-content p {
    margin-bottom: 1.5rem;
  }

  .page-content ul,
  .page-content ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .page-content li {
    margin-bottom: 0.5rem;
  }

  .page-content a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: opacity 0.2s ease;
  }

  .page-content a:hover {
    opacity: 0.5;
  }
{% endstyle %}

<div class="page-section full-width">
  <div class="page-container">
    <div class="page-header">
      <h1 class="page-title">
        {{ page.title | escape }}
      </h1>
    </div>
    <div class="page-content">
      {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "class": "section",
  "settings": []
}
{% endschema %}
