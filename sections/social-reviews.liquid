{% style %}
  .social-reviews-section {
    padding: 6rem 0;
    background-color: #FFFFFF;
    border-top: 1px solid #000000;
  }

  .reviews-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .reviews-title {
    font-size: 2rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1px;
    background-color: #000000;
    border: 1px solid #000000;
  }

  .review-card {
    background-color: #FFFFFF;
    display: flex;
    flex-direction: column;
  }

  .review-image {
    width: 100%;
    aspect-ratio: 4/5;
    background-color: #F5F5F5;
    border-bottom: 1px solid #000000;
  }

  .review-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .review-content {
    padding: 1.5rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .review-stars {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    letter-spacing: 0.2em;
  }

  .review-text {
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .review-author {
    font-weight: 900;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media screen and (max-width: 768px) {
    .reviews-grid {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<div class="social-reviews-section full-width">
  <div class="reviews-header">
    <h2 class="reviews-title">{{ section.settings.title }}</h2>
  </div>

  <div class="reviews-grid">
    {% for block in section.blocks %}
      <div class="review-card" {{ block.shopify_attributes }}>
        <div class="review-image">
          {% if block.settings.image %}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="Customer Fit Pic" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
        <div class="review-content">
          <div class="review-stars">
            {% for i in (1..block.settings.rating) %}★{% endfor %}
          </div>
          <div class="review-text">"{{ block.settings.text }}"</div>
          <div class="review-author">— {{ block.settings.author }}</div>
        </div>
      </div>
    {% endfor %}
    
    {% if section.blocks.size == 0 %}
      {% for i in (1..4) %}
        <div class="review-card">
          <div class="review-image">
             {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
          <div class="review-content">
            <div class="review-stars">★★★★★</div>
            <div class="review-text">"Impeccable quality and perfect oversized fit. The attention to detail is unmatched."</div>
            <div class="review-author">— CLIENT {{ i }}</div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Social Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "COMMUNITY"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fit Pic"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review Text",
          "default": "Impeccable quality and perfect oversized fit."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "UNKNOWN"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
