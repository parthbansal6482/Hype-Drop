{% style %}
  .hero-section--{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: {{ section.settings.hero_height }}vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: var(--color-background);
  }

  .hero-video-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  .hero-video-wrapper video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    z-index: 2;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    text-align: center;
    max-width: 800px;
    padding: 0 2rem;
  }

  .hero-heading {
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: #FFFFFF;
  }

  .hero-cta {
    display: inline-block;
    padding: 1rem 3rem;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background-color: transparent;
    color: #FFFFFF;
    border: 1px solid #FFFFFF;
    border-radius: var(--style-border-radius-buttons);
    transition: background-color var(--transition-duration) var(--transition-curve),
                color var(--transition-duration) var(--transition-curve);
  }

  .hero-cta:hover {
    background-color: #FFFFFF;
    color: #000000;
  }
{% endstyle %}

<div class="hero-section--{{ section.id }}">
  <div class="hero-video-wrapper">
    {% if section.settings.video_url != blank %}
      <video autoplay loop muted playsinline>
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>
  
  <div class="hero-overlay"></div>

  <div class="hero-content">
    {% if section.settings.heading != blank %}
      <h1 class="hero-heading">{{ section.settings.heading }}</h1>
    {% endif %}
    
    {% if section.settings.cta_text != blank and section.settings.cta_link != blank %}
      <a href="{{ section.settings.cta_link }}" class="hero-cta">
        {{ section.settings.cta_text }}
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Cinematic Video Hero",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Video Asset URL (MP4)",
      "info": "Paste the direct link to an MP4 video."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE NEW STANDARD"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Label",
      "default": "SHOP THE DROP"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "hero_height",
      "min": 50,
      "max": 100,
      "step": 10,
      "unit": "vh",
      "label": "Section Height",
      "default": 100
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Cinematic Video Hero",
      "category": "Video"
    }
  ]
}
{% endschema %}
